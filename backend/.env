# 1. GÜVENLİK VE DJANGO AYARLARI
# Kendi bilgisayarında (local) çalışırken DJANGO_DEBUG=True yapabilirsin.
# Ancak sunucuda (Docker'da) hata sayfalarının sızmaması için kesinlikle False kalmalı.
DJANGO_DEBUG=False

# Şifrenin etrafında tırnak işareti (', ") KULLANMA.
DJANGO_SECRET_KEY=django-insecure-f7kdg!#w%w$5()_(*0dp+*y_fzu=c+a3@+-(0vzizb9dds23e)

# Cloudflare Tunnels veya farklı IP'lerden erişimi test edebilmek için şimdilik '*' (hepsi) diyoruz.
# Canlıya domain ile aldığımızda buraya "hocanin-sitesi.com,www.hocanin-sitesi.com" yazacağız.
DJANGO_ALLOWED_HOSTS=*

# 2. VERİTABANI AYARLARI
# Bu kısımdaki bilgiler docker-compose.yml içindeki db servisiyle birebir aynı olmalı.
DB_NAME=insaat-db
DB_USER=postgres
DB_PASSWORD=postgres123
DB_HOST=db
DB_PORT=5432
